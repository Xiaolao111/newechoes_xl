---
interface Props {}

const {} = Astro.props;

const currentYear = new Date().getFullYear();
// 有正式备案号后，把文案改成例如「沪ICP备xxxxxxxx号」
const beianText = "苏ICP备2026028642号";
const beianHref = "https://beian.miit.gov.cn/";
---

<footer
  class="w-full py-6 px-4 bg-gray-50 dark:bg-dark-bg border-t border-gray-200 dark:border-gray-800 mt-auto"
>
  <div
    class="max-w-7xl mx-auto flex flex-col items-center justify-center space-y-4"
  >
    <div
      class="text-sm text-gray-500 dark:text-gray-500 font-light flex flex-wrap items-center justify-center gap-2"
    >
      <span>© {currentYear} xiaolao</span>
      <span
        aria-hidden="true"
        class="hidden sm:inline"
        >·</span
      >
      <a
        href="/about"
        class="hover:text-primary-600 dark:hover:text-primary-400"
        data-astro-prefetch="hover"
      >
        关于
      </a>
      <span
        aria-hidden="true"
        class="hidden sm:inline"
        >·</span
      >
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary-600 dark:hover:text-primary-400"
        aria-label="RSS订阅"
      >
        RSS
      </a>
      <span
        aria-hidden="true"
        class="hidden sm:inline"
        >·</span
      >
      <a
        href={beianHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary-600 dark:hover:text-primary-400"
      >
        {beianText}
      </a>
    </div>
  </div>
</footer>
