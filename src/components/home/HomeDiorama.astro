---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import "./diorama.css";

const articles = await getCollection("articles", ({ data }: CollectionEntry<"articles">) => !data.draft);
const postCount = articles.length;
const years = (() => {
  const dates = articles
    .map((a: CollectionEntry<"articles">) => a.data.date)
    .filter(Boolean)
    .map((d: Date | string) => new Date(d));
  if (!dates.length) return 1;
  const minYear = Math.min(...dates.map((d: Date) => d.getFullYear()));
  return Math.max(1, new Date().getFullYear() - minYear + 1);
})();
const autoPostsLabel = `${postCount} 篇 · 近 ${years} 年`;
---

<div class="home-diorama" aria-label="interactive 3D diorama homepage">
  <canvas class="home-diorama__canvas" data-diorama-canvas aria-hidden="true"></canvas>

  <div class="home-diorama__hud">
    <div class="diorama-hint" data-diorama-hint aria-hidden="true">
      <span>drag to orbit · scroll for seasons · click objects</span>
    </div>
  </div>

  <div class="diorama-sr-nav" aria-label="quick navigation">
    <a href="/articles" data-astro-prefetch="hover">文章</a>
    <a href="/projects" data-astro-prefetch="hover">项目</a>
    <a href="/about" data-astro-prefetch="hover">关于</a>
    <a href="/books" data-astro-prefetch="hover">读书</a>
    <a href="/movies" data-astro-prefetch="hover">观影</a>
    <a href="/music" data-astro-prefetch="hover">歌单</a>
  </div>

  <div class="diorama-tooltip" data-diorama-tooltip aria-hidden="true"></div>

  <section
    class="diorama-music-player"
    data-diorama-music-player
    aria-label="音乐播放器"
    aria-hidden="true"
  >
    <a class="diorama-music-player__cover-link" href="/music" aria-label="打开完整歌单">
      <img data-music-cover alt="" />
    </a>
    <div class="diorama-music-player__body">
      <span class="diorama-music-player__eyebrow">NOW PLAYING</span>
      <a class="diorama-music-player__title" data-music-title href="/music"></a>
      <span class="diorama-music-player__artist" data-music-artist></span>
      <span class="diorama-music-player__error" data-music-error></span>
      <div class="diorama-music-player__controls">
        <button type="button" data-music-previous aria-label="上一首">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 5v14M18 6l-9 6 9 6V6z"></path>
          </svg>
        </button>
        <button
          class="diorama-music-player__play"
          type="button"
          data-music-toggle
          aria-label="播放"
        >
          <svg data-music-play-icon viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7L8 5z"></path>
          </svg>
          <svg data-music-pause-icon viewBox="0 0 24 24" aria-hidden="true" hidden>
            <path d="M7 5h4v14H7zM13 5h4v14h-4z"></path>
          </svg>
        </button>
        <button type="button" data-music-next aria-label="下一首">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 5v14M6 6l9 6-9 6V6z"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>
</div>

<script is:inline define:vars={{ autoPostsLabel }}>
  window.__HOME_POSTS_LABEL = autoPostsLabel;
</script>

<script>
  import { initDiorama } from "./diorama";

  const isHome = () => {
    const p = window.location.pathname;
    return p === "/" || p === "";
  };

  let initFrame = 0;
  const maybeInit = () => {
    // Swup replaces <main> asynchronously. Wait one frame so the new homepage
    // canvas exists before binding Three.js controls and pointer handlers.
    if (initFrame) cancelAnimationFrame(initFrame);
    initFrame = requestAnimationFrame(() => {
      initFrame = 0;
      if (
        isHome() &&
        document.querySelector<HTMLCanvasElement>("[data-diorama-canvas]")
      ) {
        initDiorama();
      }
    });
  };

  // Initial page load
  maybeInit();

  // Astro view transitions (fallback)
  document.addEventListener("astro:page-load", maybeInit);

  // Swup navigations — content has been replaced, diorama DOM is fresh
  document.addEventListener("swup:contentReplaced", maybeInit);
  document.addEventListener("swup:page:view", maybeInit);
</script>
